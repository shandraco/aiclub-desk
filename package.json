{
  "name": "aiclub-content-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && E2E_SKIP_BUILD=1 pnpm test:e2e",
    "screenshots": "SCREENSHOTS=1 E2E_SKIP_BUILD=1 playwright test screenshots",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "admin:create": "node --env-file-if-exists=.env.local --import tsx scripts/create-admin.ts",
    "seed:demo": "node --env-file-if-exists=.env.local --import tsx scripts/seed-demo.ts",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@node-rs/argon2": "2.2.1",
    "@sentry/nextjs": "10.76.2",
    "@vercel/blob": "2.8.0",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.3",
    "fflate": "0.8.3",
    "html-to-image": "1.11.13",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "author": "Aege"
}
