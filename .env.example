# Copy to .env.local for local work. Never commit real values; on Vercel they are set by the
# Neon and Blob integrations, or with `vercel env add NAME production`.

SITE_URL=http://localhost:3000
LOG_LEVEL=info

# Local Postgres (createdb aiclub_desk). On Vercel the Neon integration sets this.
DATABASE_URL=postgres://localhost:5432/aiclub_desk

# Vercel Blob read-write token: `vercel env pull` after connecting a Blob store.
# Without it the desk works but photo and logo uploads are off.
# BLOB_READ_WRITE_TOKEN=
